{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebius.com/npa/schemas/agent-benchmark-report-v1.json",
  "title": "NPA bounded agent benchmark report",
  "type": "object",
  "required": [
    "schema",
    "status",
    "provider",
    "operation",
    "model_calls",
    "tool_calls",
    "summary"
  ],
  "properties": {
    "schema": {"const": "npa.agent.benchmark.v1"},
    "status": {
      "enum": ["complete", "needs_confirmation", "blocked_no_progress", "unknown"]
    },
    "provider": {
      "type": "object",
      "required": ["kind", "model", "tls_verification", "endpoint_disclosed"],
      "properties": {
        "kind": {"const": "openai_compatible"},
        "model": {"type": "string", "minLength": 1},
        "tls_verification": {"const": true},
        "endpoint_disclosed": {"const": false}
      },
      "additionalProperties": true
    },
    "operation": {
      "type": "object",
      "required": ["digest", "workflow", "seed_fixture", "variant_count", "run_id_digest"],
      "properties": {
        "digest": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
        "workflow": {"const": "paidf-cosmos3"},
        "seed_fixture": {"const": true},
        "variant_count": {"const": 1},
        "accelerator": {"type": "string"},
        "run_id_digest": {"type": "string", "pattern": "^[a-f0-9]{16}$"}
      },
      "additionalProperties": true
    },
    "high_context": {"type": ["object", "null"]},
    "concurrency": {"type": ["object", "null"]},
    "baseline": {"type": ["object", "null"]},
    "model_calls": {"type": "array", "items": {"type": "object"}},
    "tool_calls": {"type": "array", "items": {"type": "object"}},
    "agent_rounds": {"type": "array", "items": {"type": "object"}},
    "authorizations": {"type": "array", "items": {"type": "object"}},
    "summary": {
      "type": "object",
      "required": ["wall_s", "model_calls", "tool_calls", "usage", "execution_evidence", "cost"],
      "properties": {
        "wall_s": {"type": "number", "minimum": 0},
        "model_calls": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "usage": {"type": "object"},
        "execution_evidence": {
          "type": "object",
          "required": ["stage_timings", "resource_measurements", "source_tool_calls", "availability"],
          "properties": {
            "stage_timings": {"type": "array", "items": {"type": "object"}},
            "resource_measurements": {"type": "array", "items": {"type": "object"}},
            "source_tool_calls": {"type": "integer", "minimum": 0},
            "availability": {"enum": ["measured", "not_reported"]}
          }
        },
        "cost": {
          "type": "object",
          "required": ["monetary", "status", "measured_token_usage"],
          "properties": {
            "monetary": {"type": ["number", "null"]},
            "status": {"enum": ["available", "unavailable"]},
            "measured_token_usage": {"type": "object"}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
