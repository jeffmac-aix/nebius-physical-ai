+    def on_viewport_captured(buffer, buffer_size, width, height, _byte_format):
+        """Atomically publish one real RTX viewport frame for the agent relay."""
+        try:
+            pointer_type = ctypes.POINTER(ctypes.c_byte * buffer_size)
+            ctypes.pythonapi.PyCapsule_GetPointer.restype = pointer_type
+            ctypes.pythonapi.PyCapsule_GetPointer.argtypes = [ctypes.py_object, ctypes.c_char_p]
+            content = ctypes.pythonapi.PyCapsule_GetPointer(buffer, None)
+            image = Image.frombytes(
+                "RGBA", (width, height), content.contents
+            ).convert("RGB")
+            if image.width > 1280 or image.height > 720:
+                image.thumbnail((1280, 720), Image.Resampling.LANCZOS)
+            temporary = frame_path + ".tmp"
+            image.save(temporary, format="JPEG", quality=82, optimize=False)
+            os.replace(temporary, frame_path)
+        except Exception as exc:
+            print(
+                f"[WARN] Could not capture browser frame: "
+                f"{type(exc).__name__}: {exc}"
+            )
+        finally:
+            capture_state["pending"] = False
+            capture_state["next_at"] = time.monotonic() + 0.15
+
+    def schedule_browser_capture():
+        if (
+            viewport is None
+            or capture_state["pending"]
+            or time.monotonic() < capture_state["next_at"]
+        ):
+            return
+        capture_state["pending"] = True
+        try:
+            capture_viewport_to_buffer(viewport, on_viewport_captured)
+        except Exception as exc:
+            capture_state["pending"] = False
+            capture_state["next_at"] = time.monotonic() + 1.0
+            print(
+                f"[WARN] Could not schedule browser frame: "
+                f"{type(exc).__name__}: {exc}"
+            )
+
+    if frame_path:
+        if viewport is None:
+            raise RuntimeError("browser teleoperation requires an active RTX viewport")
+        env.render()
+        schedule_browser_capture()
