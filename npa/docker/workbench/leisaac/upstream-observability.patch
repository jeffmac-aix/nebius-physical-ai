+    def _read_remote_inputs(self):
+        if self._remote_queue is None:
+            return
+        try:
+            with self._remote_queue.open("r", encoding="utf-8") as queue:
+                queue.seek(self._remote_offset)
+                records = queue.readlines()
+                self._remote_offset = queue.tell()
+        except OSError:
+            return
+        for record in records:
