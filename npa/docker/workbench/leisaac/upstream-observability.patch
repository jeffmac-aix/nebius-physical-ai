+    def _record_applied_input(self):
+        if self._applied_counter is None:
+            return
+        try:
+            current = self._applied_counter.read_text(encoding="utf-8").strip()
+            count = int(current or "0") + 1
+            temporary = self._applied_counter.with_suffix(".tmp")
+            temporary.write_text(f"{count}\n", encoding="utf-8")
+            temporary.replace(self._applied_counter)
+        except (OSError, ValueError):
+            pass
+
+    def _read_remote_inputs(self):
+        if self._remote_queue is None:
+            return
+        try:
+            with self._remote_queue.open("r", encoding="utf-8") as queue:
+                queue.seek(self._remote_offset)
+                records = queue.readlines()
+                self._remote_offset = queue.tell()
+        except OSError:
+            return
+        for record in records:
+            try:
+                payload = json.loads(record)
+            except ValueError:
+                continue
+            key = str(payload.get("key") or "").upper()
+            event = str(payload.get("event") or "")
+            if event != "press":
+                continue
+            if key in self._INPUT_KEY_MAPPING:
+                self._started = True
+                self._remote_pulses[key] = 8
+                self._record_applied_input()
+            elif key in {"R", "N"}:
+                self._started = False
+                self._reset_state = True
+                if key in self._additional_callbacks:
+                    self._additional_callbacks[key]()
+                self._record_applied_input()
+
+    def get_device_state(self):
+        self._read_remote_inputs()
+        remote_action = np.zeros(8)
+        for key, remaining in list(self._remote_pulses.items()):
+            if remaining <= 0:
+                self._remote_pulses.pop(key, None)
+                continue
+            remote_action += self._ACTION_DELTA_MAPPING[self._INPUT_KEY_MAPPING[key]]
+            self._remote_pulses[key] = remaining - 1
+        return self._convert_delta_from_frame(self._delta_action + remote_action)
+
